(in-package :slice2volume)

(serapeum:-> downsample-3d ((simple-array (unsigned-byte 8) (* * *))
                            (integer 1 255))
             (values (simple-array (unsigned-byte 8) (* * *)) &optional))
(defun downsample-3d (array n)
  (declare (optimize (speed 3)))
  (let* ((d  (array-dimension array 0))
         (h  (array-dimension array 1))
         (w  (array-dimension array 2))
         (nd (ceiling d n))
         (nh (ceiling h n))
         (nw (ceiling w n))
         (result32 (make-array (list nd nh nw)
                               :element-type '(unsigned-byte 32)
                               :initial-element 0))
         (result8  (make-array (list nd nh nw)
                               :element-type '(unsigned-byte 8)))
         (scale (expt n 3))
         (idx 0))
    (loop-ranges ((i d) (j h) (k w))
      (incf (aref result32
                  (floor i n)
                  (floor j n)
                  (floor k n))
            (row-major-aref array idx))
      (incf idx))
    (loop for i below (array-total-size result8) do
      (setf (row-major-aref result8 i)
            (floor (row-major-aref result32 i) scale)))
    result8))
