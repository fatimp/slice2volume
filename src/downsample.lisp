(in-package :slice2volume)

(serapeum:-> downsample3d ((simple-array single-float (* * *))
                         (integer 1 255))
             (values (simple-array single-float (* * *)) &optional))
(defun downsample3d (array n)
  (declare (optimize (speed 3)))
  (let* ((d  (array-dimension array 0))
         (h  (array-dimension array 1))
         (w  (array-dimension array 2))
         (nd (ceiling d n))
         (nh (ceiling h n))
         (nw (ceiling w n))
         (result (make-array (list nd nh nw)
                             :element-type 'single-float
                             :initial-element 0.0))
         (scale (floor (expt n 3)))
         (idx 0))
    (loop-ranges ((i d) (j h) (k w))
      (incf (aref result
                  (floor i n)
                  (floor j n)
                  (floor k n))
            (/ (row-major-aref array idx) scale))
      (incf idx))
    result))

(serapeum:-> downsample2d ((simple-array single-float (* *))
                         (integer 1 255))
             (values (simple-array single-float (* *)) &optional))
(defun downsample2d (array n)
  (declare (optimize (speed 3)))
  (let* ((d  (array-dimension array 0))
         (h  (array-dimension array 1))
         (nd (ceiling d n))
         (nh (ceiling h n))
         (result (make-array (list nd nh)
                             :element-type 'single-float
                             :initial-element 0.0))
         (scale (floor (expt n 2)))
         (idx 0))
    (loop-ranges ((i d) (j h))
      (incf (aref result
                  (floor i n)
                  (floor j n))
            (/ (row-major-aref array idx) scale))
      (incf idx))
    result))
